<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifest of the Microsoft Store package. build-msix.ps1 fills in the placeholders:
  the identity comes from store\identity.json (values copied from Partner Center), the version from
  Directory.Build.props. See docs\STORE.md.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap17="http://schemas.microsoft.com/appx/manifest/uap/windows10/17"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 uap17 desktop rescap">

  <Identity
    Name="__IDENTITY_NAME__"
    Publisher="__IDENTITY_PUBLISHER__"
    Version="__VERSION__"
    ProcessorArchitecture="__ARCH__" />

  <Properties>
    <DisplayName>__DISPLAY_NAME__</DisplayName>
    <PublisherDisplayName>__PUBLISHER_DISPLAY_NAME__</PublisherDisplayName>
    <Description>Downloads shared OneDrive and Google Drive folders and files</Description>
    <Logo>Assets\StoreLogo.png</Logo>
    <!-- An update waits until CloudLink is closed instead of ending a download (Windows 11 24H2 and later). -->
    <uap17:UpdateWhileInUse>defer</uap17:UpdateWhileInUse>
  </Properties>

  <Resources>
    <Resource Language="en-US" />
  </Resources>

  <Dependencies>
    <!-- 19041 (Windows 10 2004): from 1903 on, what the app writes under AppData is kept the way AppPackage.cs expects. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Applications>
    <!-- The Id must never change once the app is published. -->
    <Application Id="CloudLink" Executable="CloudLink.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="__DISPLAY_NAME__"
        Description="Downloads shared OneDrive and Google Drive folders and files"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          ShortName="CloudLink"
          Square71x71Logo="Assets\SmallTile.png"
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square310x310Logo="Assets\LargeTile.png">
          <uap:ShowNameOnTiles>
            <uap:ShowOn Tile="square150x150Logo" />
            <uap:ShowOn Tile="wide310x150Logo" />
            <uap:ShowOn Tile="square310x310Logo" />
          </uap:ShowNameOnTiles>
        </uap:DefaultTile>
      </uap:VisualElements>
      <Extensions>
        <!-- "cloudlink" from Win+R or a terminal, so that a switch (software rendering, a theme) can be passed. -->
        <uap3:Extension Category="windows.appExecutionAlias" Executable="CloudLink.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="cloudlink.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <!-- Every packaged desktop (WPF) program declares this; it is explained to the Store on the Submission options page. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
