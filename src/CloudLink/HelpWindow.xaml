<Window x:Class="CloudLink.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CloudLink help" Width="620" Height="700" MinWidth="600" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="/Assets/CloudLink.ico">
    <Grid TextElement.Foreground="{DynamicResource TextBrush}" Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Image Source="{StaticResource LogoImage}" Width="40" Height="40" Margin="0,0,12,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="How CloudLink works" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Opacity="0.6" Text="The few ideas worth knowing, in plain words" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel x:Name="Topics" Margin="0,0,6,0" />
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Height="38" IsCancel="True" IsDefault="True" Content="Got it" />
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="OpenLog_Click" Margin="0,0,10,0" Content="Open log"
                    ToolTip="A record of what happened, useful when asking for help" />
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="OpenPrivacy_Click" Margin="0,0,10,0" Content="Privacy"
                    ToolTip="Opens the privacy statement in your browser" />
            <StackPanel VerticalAlignment="Center" Opacity="0.7">
                <TextBlock x:Name="VersionText" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="© AMG Cloud Engineering" FontSize="11.5" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
