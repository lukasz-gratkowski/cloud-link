<Application x:Class="CloudLink.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             ThemeMode="System">
    <Application.Resources>

        <!-- ===== Brand ===== -->
        <Color x:Key="BrandAzure">#2E7BFF</Color>
        <Color x:Key="BrandViolet">#7B4DFF</Color>
        <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="{StaticResource BrandAzure}" />
            <GradientStop Offset="1" Color="{StaticResource BrandViolet}" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BrandGradientH" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="{StaticResource BrandAzure}" />
            <GradientStop Offset="1" Color="{StaticResource BrandViolet}" />
        </LinearGradientBrush>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Theme-dependent values. These are the dark ones; Theme.Apply replaces them to match Windows. -->
        <SolidColorBrush x:Key="TextBrush" Color="#F5FFFFFF" />
        <SolidColorBrush x:Key="CardBrush" Color="#12FFFFFF" />
        <SolidColorBrush x:Key="CardStrokeBrush" Color="#1FFFFFFF" />
        <SolidColorBrush x:Key="TrackBrush" Color="#24FFFFFF" />
        <SolidColorBrush x:Key="HoverBrush" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="OkBrush" Color="#3DD68C" />
        <SolidColorBrush x:Key="WarnBrush" Color="#FFB84D" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#FF6B6B" />
        <SolidColorBrush x:Key="ActiveBrush" Color="#6AA5FF" />
        <SolidColorBrush x:Key="IdleBrush" Color="#7F8794" />
        <sys:Double x:Key="AuroraOpacity">0.38</sys:Double>

        <!-- The mark: gradient tile, white cloud, arrow. tools\make-icon.ps1 draws the same shapes for the .ico. -->
        <DrawingImage x:Key="LogoImage">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="{StaticResource BrandGradient}">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="2,2,60,60" RadiusX="15" RadiusY="15" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="White">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup FillRule="Nonzero">
                                <EllipseGeometry Center="24,31" RadiusX="10" RadiusY="10" />
                                <EllipseGeometry Center="38,27" RadiusX="14" RadiusY="14" />
                                <RectangleGeometry Rect="10,31,44,20" RadiusX="10" RadiusY="10" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="M32,27 L32,44 M25,37 L32,44 L39,37">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#3D6BFA" Thickness="4.5" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- ===== Surfaces ===== -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="20" />
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.72" />
        </Style>

        <!-- ===== Buttons ===== -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="26,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="Scale" />
                            </Grid.RenderTransform>
                            <Border x:Name="Glow" CornerRadius="14" Margin="8,10,8,-3" Opacity="0.55"
                                    Background="{StaticResource BrandGradient}">
                                <Border.Effect>
                                    <BlurEffect Radius="16" />
                                </Border.Effect>
                            </Border>
                            <Border CornerRadius="14" Background="{StaticResource BrandGradient}" />
                            <Border x:Name="Shine" CornerRadius="14" Background="White" Opacity="0" />
                            <Border x:Name="Ring" CornerRadius="17" Margin="-3" BorderThickness="2"
                                    BorderBrush="{DynamicResource TextBrush}" Visibility="Collapsed" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Shine" Storyboard.TargetProperty="Opacity" To="0.14" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Shine" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2" />
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0:0:0.08" />
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0:0:0.08" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                                <Setter TargetName="Glow" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border CornerRadius="10" Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1" />
                            <Border x:Name="Hover" CornerRadius="10" Background="{DynamicResource HoverBrush}" Opacity="0" />
                            <Border x:Name="Ring" CornerRadius="12" Margin="-2" BorderThickness="2"
                                    BorderBrush="{StaticResource BrandGradient}" Visibility="Collapsed" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="16" />
        </Style>

        <!-- One segment of the All / In progress / Problems switch. -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Hover" CornerRadius="8" Background="{DynamicResource HoverBrush}" Opacity="0" />
                            <Border x:Name="On" CornerRadius="8" Background="{StaticResource BrandGradientH}" Opacity="0" />
                            <Border x:Name="Ring" CornerRadius="9" Margin="-1" BorderThickness="2"
                                    BorderBrush="{DynamicResource TextBrush}" Visibility="Collapsed" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="On" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Progress ===== -->
        <!-- The main bar. Tag="active" runs the travelling highlight; nothing animates while idle. -->
        <Style x:Key="BrandProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="10" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="5" Background="{DynamicResource TrackBrush}" />
                            <Border x:Name="Busy" CornerRadius="5" Background="{StaticResource BrandGradientH}" Opacity="0.45" Visibility="Collapsed" />
                            <Border x:Name="PART_Indicator" CornerRadius="5" HorizontalAlignment="Left"
                                    Background="{StaticResource BrandGradientH}" />
                            <Border x:Name="Shimmer" CornerRadius="5" Visibility="Collapsed"
                                    Width="{Binding ActualWidth, ElementName=PART_Indicator}" HorizontalAlignment="Left">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <LinearGradientBrush.RelativeTransform>
                                            <TranslateTransform X="-1" />
                                        </LinearGradientBrush.RelativeTransform>
                                        <GradientStop Offset="0.30" Color="#00FFFFFF" />
                                        <GradientStop Offset="0.50" Color="#8CFFFFFF" />
                                        <GradientStop Offset="0.70" Color="#00FFFFFF" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Setter TargetName="PART_Indicator" Property="Visibility" Value="Hidden" />
                                <Setter TargetName="Busy" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Shimmer" Property="Width" Value="NaN" />
                                <Setter TargetName="Shimmer" Property="HorizontalAlignment" Value="Stretch" />
                            </Trigger>
                            <Trigger Property="Tag" Value="active">
                                <Setter TargetName="Shimmer" Property="Visibility" Value="Visible" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="ShimmerRun">
                                        <Storyboard RepeatBehavior="Forever" Timeline.DesiredFrameRate="24">
                                            <DoubleAnimation Storyboard.TargetName="Shimmer"
                                                             Storyboard.TargetProperty="(Border.Background).(Brush.RelativeTransform).(TranslateTransform.X)"
                                                             From="-1" To="1" Duration="0:0:1.8" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="ShimmerRun" />
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The per-file bar: same colours, no animation, cheap enough for thousands of rows. -->
        <Style x:Key="RowProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="5" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="2.5" Background="{DynamicResource TrackBrush}" />
                            <Border x:Name="PART_Indicator" CornerRadius="2.5" HorizontalAlignment="Left"
                                    Background="{StaticResource BrandGradientH}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
