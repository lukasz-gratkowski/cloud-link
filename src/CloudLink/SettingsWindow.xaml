<Window x:Class="CloudLink.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CloudLink settings" Width="660" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="/Assets/CloudLink.ico">
    <DockPanel TextElement.Foreground="{DynamicResource TextBrush}">
        <!-- Outside the scrolling part, so Save can always be reached. -->
        <DockPanel DockPanel.Dock="Bottom" Margin="24,12,24,20">
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Height="38" Click="Save_Click" IsDefault="True" Content="Save" />
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" IsCancel="True" MinWidth="90" Margin="0,0,10,0" Content="Cancel" />
            <TextBlock x:Name="VersionText" VerticalAlignment="Center" Opacity="0.7" />
        </DockPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="24,20,24,0">
        <Border x:Name="ReasonCard" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12" Visibility="Collapsed"
                BorderBrush="{DynamicResource WarnBrush}">
            <TextBlock x:Name="ReasonText" TextWrapping="Wrap" FontWeight="SemiBold" />
        </Border>

        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Google Drive" FontSize="16" FontWeight="SemiBold" />
                <TextBlock TextWrapping="Wrap" Opacity="0.8" Margin="0,4,0,10" LineHeight="20">
                    Google asks every user to create their own access, once, in the Google Cloud console:<LineBreak />
                    1.  Create a project and enable "Google Drive API".<LineBreak />
                    2.  For links anyone can open: create an API key and paste it below.<LineBreak />
                    3.  For private links: create an OAuth client of type "Desktop app" and paste its ID and secret below.
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Style="{StaticResource GhostButton}" Click="OpenGoogleConsole_Click" Content="Open Google Cloud console" />
                    <Button Style="{StaticResource GhostButton}" Click="OpenGuide_Click" Margin="8,0,0,0" Content="Step-by-step guide" />
                </StackPanel>
                <TextBlock Style="{StaticResource Caption}" Text="API KEY (PUBLIC LINKS)" />
                <PasswordBox x:Name="GoogleApiKeyBox" Margin="0,4,0,10" AutomationProperties.Name="Google API key" />
                <TextBlock Style="{StaticResource Caption}" Text="OAUTH CLIENT ID (SIGN-IN)" />
                <TextBox x:Name="GoogleClientIdBox" Margin="0,4,0,10" AutomationProperties.Name="Google OAuth client ID" />
                <TextBlock Style="{StaticResource Caption}" Text="OAUTH CLIENT SECRET" />
                <PasswordBox x:Name="GoogleClientSecretBox" Margin="0,4,0,0" AutomationProperties.Name="Google OAuth client secret" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="OneDrive" FontSize="16" FontWeight="SemiBold" />
                <TextBlock x:Name="MicrosoftIntro" TextWrapping="Wrap" Opacity="0.8" Margin="0,4,0,10" LineHeight="20" />
                <StackPanel x:Name="MicrosoftSetupButtons" Orientation="Horizontal" Margin="0,0,0,12" Visibility="Collapsed">
                    <Button Style="{StaticResource GhostButton}" Click="OpenEntra_Click" Content="Open Microsoft Entra admin center" />
                    <Button Style="{StaticResource GhostButton}" Click="OpenRegistrationGuide_Click" Margin="8,0,0,0" Content="Step-by-step guide" />
                </StackPanel>
                <TextBlock x:Name="MicrosoftCaption" Style="{StaticResource Caption}" Text="APPLICATION (CLIENT) ID, OPTIONAL" />
                <TextBox x:Name="MicrosoftClientIdBox" Margin="0,4,0,0" AutomationProperties.Name="Microsoft application ID" />
                <TextBlock x:Name="MicrosoftError" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}" Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,4">
            <DockPanel>
                <ComboBox x:Name="ParallelBox" DockPanel.Dock="Right" MinWidth="76" AutomationProperties.Name="Files downloaded at the same time" />
                <StackPanel>
                    <TextBlock Text="Files downloaded at the same time" FontWeight="SemiBold" />
                    <TextBlock Opacity="0.7" Text="4 suits most connections. Lower it if the service keeps asking to slow down." TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>
    </StackPanel>
    </ScrollViewer>
    </DockPanel>
</Window>
